// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------- Enums -----------------------------------

enum CultMemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum CultMembershipStatus {
  ACTIVE
  LEFT
  REMOVED // kicked by a leader — kept distinct from LEFT for history/disputes
}

enum CultInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED // leader cancelled it before response
  EXPIRED
}

enum Role {
  ADMIN
  CLIENT
  CREATIVE
}

enum AvailabilityStatus {
  AVAILABLE
  BUSY
  NOT_AVAILABLE
}

// Fixed vocabulary so the discover-page filter tabs never drift out of sync
// with what creatives can actually select on their profile.
enum Discipline {
  FILM_VIDEO
  VFX_3D
  FASHION_STYLING
  SOUND_AUDIO
  DESIGN_BRAND
  PHOTOGRAPHY
  MOTION_GRAPHICS
}

enum RateType {
  HOURLY
  DAILY
  PROJECT
  NEGOTIABLE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  FREELANCE
  SELF_EMPLOYED
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  EXPERT
}

enum Degree {
  HIGH_SCHOOL
  DIPLOMA
  BSC
  BCA
  BCOM
  BA
  BTECH
  BE
  BPHARM
  LLB
  MBBS
  MSC
  MCA
  MCOM
  MA
  MTECH
  ME
  MBA
  MPHARM
  LLM
  MD
  PHD
  OTHER
}

enum JoinAs {
  FREELANCER
  COLLECTIVE
  CLIENT
}

enum PortfolioOwnerType {
  FREELANCER
  CULT
}

enum PortfolioCreditStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum ClientType {
  INDIVIDUAL
  COMPANY
}

enum CompanySize {
  SOLO // just me
  SMALL // 2-10 employees
  MEDIUM // 11-50 employees
  LARGE // 51-200 employees
  ENTERPRISE // 201+ employees
}

enum ListingStatus {
  DRAFT
  ACTIVE
  CLOSED
  FILLED
  ARCHIVED
}

enum LocationType {
  REMOTE
  ON_SITE
  HYBRID
}

enum Currency {
  USD
  EUR
  GBP
  INR
  CAD
  AUD
  JPY
  CNY
  CHF
  SEK
  NOK
  DKK
  SGD
  HKD
  NZD
  MXN
  BRL
  KRW
  TRY
  ZAR
}

enum Industry {
  ADVERTISING_MARKETING
  FASHION_APPAREL
  FILM_TV_ENTERTAINMENT
  MUSIC_AUDIO
  GAMING
  PUBLISHING_MEDIA
  PHOTOGRAPHY_STUDIO
  TECHNOLOGY_SOFTWARE
  ECOMMERCE_RETAIL
  REAL_ESTATE
  HOSPITALITY_TRAVEL
  FOOD_BEVERAGE
  BEAUTY_COSMETICS
  HEALTH_WELLNESS
  SPORTS_FITNESS
  EDUCATION
  FINANCE_BANKING
  NONPROFIT_NGO
  ARCHITECTURE_INTERIOR_DESIGN
  AUTOMOTIVE
  EVENTS_WEDDINGS
  OTHER
}

// ---------------------- Schemas -----------------------------

model User {
  id              String           @id
  name            String
  email           String
  emailVerified   Boolean          @default(false)
  image           String?
  role            Role?
  username        String?          @unique
  creativeProfile CreativeProfile?
  clientProfile   ClientProfile?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  sessions        Session[]
  accounts        Account[]

  cultsCreated    Cult[]
  cultInvitesSent CultInvite[] @relation("CultInvitesSent")

  reviewsGiven Review[] @relation("ReviewsGiven")

  savedCreatives SavedCreative[]
  savedCults     SavedCult[]

  phoneVerifications PhoneVerification[]

  @@unique([email])
  @@map("user")
}

model CreativeProfile {
  id                  String             @id @default(cuid())
  headline            String?
  bio                 String?
  location            String? // We're not allowing the users to manually change the location
  availability        AvailabilityStatus @default(AVAILABLE)
  onboardingCompleted Boolean            @default(false)
  coverImage          String?

  // Broad category tags used for discover-page filtering — distinct from the
  // granular CreativeSkill relation below.
  disciplines Discipline[]

  // rateAmount is null when rateType is NEGOTIABLE (no fixed number to show).
  rateType   RateType?
  rateAmount Int?

  experienceYears Int?
  tools           String[] // hardware/software stack, shown separately from skills

  isVerified Boolean @default(false)
  isFeatured Boolean @default(false)

  // rating/reviewCount are NOT stored — compute them from `reviews` at query
  // time (avg + count). No Booking model exists yet, so completedProjects
  // stays a hand-maintained placeholder until project completion is tracked
  // for real; revisit it the same way once that model exists.
  completedProjects Int      @default(0)
  reviews           Review[]

  resumeUrl        String?
  resumeFileName   String?
  resumeUploadedAt DateTime?

  skills      CreativeSkill[]
  experiences Experience[]
  education   Education[]
  // applications  Application[]    // applying to client projects

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  cultMemberships CultMembership[]
  cultInvites     CultInvite[]

  ownedPortfolioItems PortfolioItem[]
  portfolioCredits    PortfolioItemCredit[]

  savedBy SavedCreative[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One review per (reviewer, creative) pair. rating/reviewCount on
// CreativeProfile are derived from this table (avg + count), never stored.
model Review {
  id      String  @id @default(cuid())
  rating  Int // 1-5, enforced at the application layer
  comment String?

  reviewerUserId String
  reviewerUser   User   @relation("ReviewsGiven", fields: [reviewerUserId], references: [id], onDelete: Cascade)

  creativeProfileId String
  creativeProfile   CreativeProfile @relation(fields: [creativeProfileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([reviewerUserId, creativeProfileId])
  @@index([creativeProfileId])
}

model ClientProfile {
  id         String     @id @default(cuid())
  clientType ClientType @default(INDIVIDUAL)

  // Company-specific — only meaningful when clientType is COMPANY.
  // Individual clients rely on User.name instead of companyName.
  companyName String?
  industry    Industry?
  companySize CompanySize?
  foundedYear String?

  bio        String?
  website    String?
  coverImage String?
  location   String?

  phoneNumber   String?
  phoneVerified Boolean @default(false)

  onboardingCompleted Boolean @default(false)

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  listings Listing[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Listing {
  id          String        @id @default(cuid())
  title       String
  description String
  status      ListingStatus @default(DRAFT)

  // Location and work arrangement
  locationType LocationType @default(REMOTE)
  location     String? // Specific city/region for on-site or hybrid

  // Compensation
  budgetMin    Int?
  budgetMax    Int?
  rateType     RateType? // HOURLY, DAILY, PROJECT, NEGOTIABLE
  currency     Currency @default(USD)

  // Job details
  discipline   Discipline? // Primary discipline for filtering
  employmentType EmploymentType?

  // Skills required - array of skill names for flexibility
  skills       String[]

  // Timeline
  deadline     DateTime?
  startDate    DateTime?
  duration     String? // e.g., "2 weeks", "3 months", "ongoing"

  // Client relationship
  clientProfileId String
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientProfileId])
  @@index([status])
  @@index([discipline])
}

model CreativeSkill {
  id    String      @id @default(cuid())
  name  String
  level SkillLevel?

  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id])

  creativeProfileId String
  creativeProfile   CreativeProfile @relation(fields: [creativeProfileId], references: [id], onDelete: Cascade)

  @@unique([creativeProfileId, skillId])
}

model Skill {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  creativeSkills CreativeSkill[]
  createdAt      DateTime        @default(now())
}

model Cult {
  id        String  @id @default(cuid())
  name      String
  slug      String  @unique // for public cult profile URL, e.g. /cults/pixel-punks
  tagline   String?
  bio       String?
  avatarUrl String?

  createdByUserId String
  createdBy       User   @relation(fields: [createdByUserId], references: [id])

  memberships CultMembership[]
  invites     CultInvite[]
  // applications Application[]  // add once client-contacts-cult flow is built

  portfolioItems PortfolioItem[]

  savedBy SavedCult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CultMembership {
  id     String               @id @default(cuid())
  role   CultMemberRole       @default(MEMBER)
  status CultMembershipStatus @default(ACTIVE)

  cultId String
  cult   Cult   @relation(fields: [cultId], references: [id], onDelete: Cascade)

  creativeProfileId String
  creativeProfile   CreativeProfile @relation(fields: [creativeProfileId], references: [id], onDelete: Cascade)

  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  @@unique([cultId, creativeProfileId]) // can't join the same cult twice while active
  @@index([creativeProfileId])
}

model CultInvite {
  id     String           @id @default(cuid())
  status CultInviteStatus @default(PENDING)

  cultId String
  cult   Cult   @relation(fields: [cultId], references: [id], onDelete: Cascade)

  invitedByUserId String
  invitedByUser   User   @relation("CultInvitesSent", fields: [invitedByUserId], references: [id])

  invitedProfileId String
  invitedProfile   CreativeProfile @relation(fields: [invitedProfileId], references: [id], onDelete: Cascade)

  message String? // optional personal note from the leader

  respondedAt DateTime?
  expiresAt   DateTime? // optional — e.g. auto-expire after 7 days

  createdAt DateTime @default(now())

  @@index([invitedProfileId])
  @@index([cultId])
}

model PortfolioItem {
  id            String             @id @default(cuid())
  title         String
  category      String? // display label shown as a badge on portfolio cards, e.g. "Cinematography"
  description   String?
  coverImageUrl String?
  mediaUrls     String[]
  tags          String[]
  projectDate   DateTime?
  ownerType     PortfolioOwnerType

  // Ownership is exclusive: exactly one of these two is set, enforced by a
  // DB-level CHECK constraint (see migration) so a project can never be
  // orphaned or double-owned.
  ownerCreativeProfileId String?
  ownerCreativeProfile   CreativeProfile? @relation(fields: [ownerCreativeProfileId], references: [id], onDelete: Cascade)

  ownerCultId String?
  ownerCult   Cult?   @relation(fields: [ownerCultId], references: [id], onDelete: Cascade)

  credits PortfolioItemCredit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerCreativeProfileId])
  @@index([ownerCultId])
}

// Contributor tagging. Separate from ownership: credits decide *visibility*
// (can show on many profiles at once), ownership decides *edit/delete rights*
// (always exactly one owner). A credit only appears on the credited
// creative's profile once they accept it — see PortfolioCreditStatus.
model PortfolioItemCredit {
  id     String                @id @default(cuid())
  role   String?
  status PortfolioCreditStatus @default(PENDING)

  portfolioItemId String
  portfolioItem   PortfolioItem @relation(fields: [portfolioItemId], references: [id], onDelete: Cascade)

  creativeProfileId String
  creativeProfile   CreativeProfile @relation(fields: [creativeProfileId], references: [id], onDelete: Cascade)

  respondedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([portfolioItemId, creativeProfileId])
  @@index([creativeProfileId])
}

model Experience {
  id               String         @id @default(cuid())
  title            String
  employmentType   EmploymentType
  companyName      String?
  industry         String?
  startDate        DateTime
  endDate          DateTime?
  currentlyWorking Boolean        @default(false)
  description      String?
  skills           String[]

  creativeProfileId String
  creativeProfile   CreativeProfile @relation(fields: [creativeProfileId], references: [id], onDelete: Cascade)
}

model Education {
  id               String @id @default(cuid())
  country          String
  school           String
  degree           Degree
  fieldOfStudy     String
  yearOfGraduation String

  creativeProfileId String
  creativeProfile   CreativeProfile @relation(fields: [creativeProfileId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Waitlist {
  id          String    @id @default(cuid())
  email       String    @unique
  joinAs      JoinAs
  createdAt   DateTime  @default(now())
  notifiedAt  DateTime?
  inviteToken String?   @unique
}

model SavedCreative {
  id                String          @id @default(cuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  creativeProfileId String
  creativeProfile   CreativeProfile @relation(fields: [creativeProfileId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())

  @@unique([userId, creativeProfileId])
  @@index([userId])
  @@index([creativeProfileId])
}

model SavedCult {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cultId    String
  cult      Cult     @relation(fields: [cultId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, cultId])
  @@index([userId])
  @@index([cultId])
}

model PhoneVerification {
  id          String   @id @default(cuid())
  userId      String
  phoneNumber String
  otpCode     String
  expiresAt   DateTime
  attempts    Int      @default(0)
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([phoneNumber])
  @@map("phone_verification")
}
